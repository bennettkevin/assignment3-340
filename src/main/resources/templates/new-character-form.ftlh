<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="./styles.css"/>
    <title>Add a Character</title>
</head>
<body>
    <div class="navbar">
        <a class="navbar-brand" href="./index.html">Home</a>
        <a class="navbar-brand" href="./detaiils.html">Details</a>
        <a class="navbar-brand" href="./about.html">About</a>
        <a class="navbar-brand" href="./new-character-form.html">Add a character</a>
    </div>
    <div class="form-group">
        <p>Name: <input class="form-control" type="text" placeholder="Character Name..."></p>
        <p>Role: <input class="form-control" type="text" placeholder="Character Role..."></p>
        <p>Universe: <input class="form-control" type="text" placeholder="Character Universe..."></p>
        <p>Image URL: <input class="form-control" type="text" placeholder="URL for Character Image..."></p>
        <p>Description: <input class="form-control" type="text" placeholder="Character Name..."></p>
    </div>
</body>
</html>